{
  "manifest_version": 3,
  "name": "Orbit BA Bridge Extension",
  "version": "0.1.0",
  "description": "Connects ChatGPT browser sessions to Orbit development workflows via a local WebSocket bridge.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "shared/protocol.js",
        "content/dom.js",
        "content/composer.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
