{
  "manifest_version": 3,
  "name": "Orbit BA Bridge Extension",
  "version": "0.1.0",
  "description": "Connects ChatGPT browser sessions to Orbit development workflows via a local WebSocket bridge.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "orbit-ba-bridge@local",
      "strict_min_version": "121.0"
    }
  },
  "background": {
    "scripts": [
      "shared/browser-compat.js",
      "shared/protocol.js",
      "background/background.js"
    ],
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "shared/browser-compat.js",
        "shared/protocol.js",
        "content/dom.js",
        "content/composer.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "token.json"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ]
    }
  ]
}
